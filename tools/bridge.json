{
  "_": "Карта событий игры → Resolume / grandMA (OSC) и MIDI. Правится в игре: шестерёнка → ВЫХОДЫ. 16 падов — строки pad1…pad16. Подстановки {поле} из события, {v127} — 0..1 → 0..127.",
  "http_port": 7777,
  "targets": {
    "resolume": {
      "host": "127.0.0.1",
      "port": 7000,
      "_": "Arena → Preferences → OSC → Enable OSC Input, порт 7000; Webserver → Enable, порт 8080 (мастер читает клипы). Установщик включает оба сам.",
      "rest_port": 8080
    },
    "ma": {
      "host": "127.0.0.1",
      "port": 8000,
      "_": "grandMA3: Menu → Network → OSC, вход 8000, префикс gma3. grandMA2 (3.3+): Setup → Network → OSC, адреса /gma2/…"
    },
    "ma2": {
      "host": "127.0.0.1",
      "port": 30000,
      "user": "administrator",
      "password": "admin",
      "_": "grandMA2 по Telnet: Setup → Console → Global Settings → Telnet → Login Enabled, сохранить шоу. Действие в карте: {\"ma2\": \"Goto Cue 2 Executor 1.1\"}"
    }
  },
  "midi_out": "DJ Wheel Out A",
  "_midi": "виртуальный порт (tools/midi_loop.cmd создаёт пару); Resolume и MA слушают «DJ Wheel Out B» как MIDI-контроллер",
  "map": {
    "pad1": [
      {
        "to": "resolume",
        "addr": "/composition/layers/1/clips/1/connect",
        "args": [
          1
        ]
      },
      {
        "to": "ma",
        "addr": "/gma3/cmd",
        "args": [
          "Go+ Executor 1"
        ]
